{
    "name": "zaikokanri-frontend",
    "version": "0.2.0",
    "private": true,
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -H 0.0.0.0 -p 3000",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
