{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "devCommand": "npm run dev",
    "installCommand": "npm ci",
    "framework": "nextjs",
    "regions": [
        "hnd1"
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://zaikokanri-backend.onrender.com/:path*"
        }
    ]
}
