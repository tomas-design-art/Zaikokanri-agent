# ====== App ======
APP_ENV=development
APP_NAME=zaikokanri-backend
LOG_LEVEL=INFO
DEMO_MODE=false

# ====== Database ======
# 開発: SQLite (ローカル開発用。DATABASE_URL未設定でも自動使用)
DATABASE_URL=sqlite:///./zaiko_app.db
# 本番: Neon PostgreSQL (Render の環境変数で上書き)
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ====== JWT ======
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ====== CORS ======
# Vercel デプロイ後の URL を CSV で列挙
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ====== AI ======
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ====== Rate Limit ======
RATE_LIMIT_LOGIN=5/minute
