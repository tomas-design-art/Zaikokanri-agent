# =============================================================
# 🔴 機密情報（絶対に公開禁止）
# =============================================================

# 環境設定ファイル（APIキー・DB設定を含む）
.env
.env.local
.env.production
.env.*.local

# =============================================================
# 🟡 ランタイム生成物（リポジトリに含めない）
# =============================================================

# SQLiteデータベース（ユーザー情報・パスワードハッシュを含む）
*.db
*.db-journal
*.db-wal
*.db-shm

# ログファイル（操作ログ・ユーザー名を含む可能性）
logs/
*.log

# バックアップ（個人データを含む可能性）
backups/

# =============================================================
# 🟢 開発環境・ビルド成果物
# =============================================================

# Python仮想環境
env/
venv/
.venv/

# Pythonキャッシュ
__pycache__/
*.py[cod]
*$py.class
*.so

# フォントファイル（サイズ大＋再配布ライセンス確認が必要）
fonts/*.ttf
fonts/*.otf

# テスト生成物
*.pdf
*.xlsx
backups/*.csv

# IDE設定
.vscode/
.idea/

# OS生成ファイル
.DS_Store
Thumbs.db
desktop.ini

# 作業中の下書き（Git に入れない）
.wip/
